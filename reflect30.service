[Unit]
Description=Reflectbot hourly Telegram and Bark reminders
Wants=network-online.target
After=network-online.target

[Service]
User=reflectbot
Group=reflectbot
WorkingDirectory=/opt/Reflectbot
ExecStart=/opt/Reflectbot/venv/bin/python /opt/Reflectbot/bot.py
Restart=always
RestartSec=10
EnvironmentFile=/opt/Reflectbot/.env
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/Reflectbot

[Install]
WantedBy=multi-user.target
